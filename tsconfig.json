{
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "preserveConstEnums": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitHelpers": false,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "types": [
      "node"
    ],
    "outDir": "./lib",
    "rootDir": "./src",
    "jsx": "react",
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "src/index.ts"
  ]
}
